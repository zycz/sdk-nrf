/*
 * Common memory map configuration for cpurad with MCUboot support
 * Shared between remote firmware and radio_loader
 *
 * Memory Layout:
 * ==============
 * MRAM (cpurad_slot0_partition @ 0x0e092000, 328 KB):
 *   [0x000 - 0x200]   MCUboot header (512 bytes)
 *   [0x200 - 0x2200]  Radio_loader (8 KB allocated)
 *   [0x2200 - 0x22200] Remote firmware (128 KB fixed)
 *   [end - 0x200]     MCUboot trailer (512 bytes)
 *
 * TCM (Runtime):
 *   cpurad_ram0 @ 0x23000000 (128 KB) - Code execution region
 *   cpurad_data_ram @ 0x23020000 (64 KB) - Data region
 */

/{
	soc{
		cpurad_data_ram: sram@23020000 {
			compatible = "mmio-sram";
			reg = < 0x23020000 0x10000 >;
			#address-cells = < 0x1 >;
			#size-cells = < 0x1 >;
			ranges = < 0x0 0x23020000 0x10000 >;
		};
	};
};



