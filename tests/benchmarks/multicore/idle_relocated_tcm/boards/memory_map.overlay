	// /delete-node/ cpuapp_slot0_partition;
	/* Shrink cpuapp_slot0_partition by 0x800 from the beginning to make space for mcuboot header */


	/*
	 * Use default cpurad_slot0_partition (defined in board DTS)
	 * cpurad_slot0_partition: 0x92000, 328 KB
	 * cpurad_slot1_partition: 0x152000, 328 KB (for DFU)
	 *
	 * Define logical regions within slot0 for build system reference
	 */

	// /* Radio_loader location in MRAM (after MCUboot header) */
