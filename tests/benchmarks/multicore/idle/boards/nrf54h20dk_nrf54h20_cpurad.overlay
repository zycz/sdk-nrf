 / {
	test_gpio {
		compatible = "gpio-keys";
		loopback: loopback {
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		};
	};
};



&gpio1 {
    status = "okay";
};

&gpiote130 {
    status = "okay";
};
